{
  "name": "alchembright-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "npm run content:validate && node scripts/deploy/thumbnails.mjs && astro build && node scripts/deploy/prefix-output.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test scripts/migration/*.test.mjs scripts/deploy/*.test.mjs",
    "migration:fetch": "node scripts/migration/fetch.mjs",
    "migration:import": "node scripts/migration/import.mjs",
    "migration:verify": "node scripts/migration/verify.mjs",
    "nginx:generate": "node scripts/deploy/generate-nginx.mjs",
    "release:prepare": "node scripts/deploy/prepare-release.mjs",
    "predev": "node scripts/deploy/thumbnails.mjs",
    "content:validate": "node scripts/deploy/validate-content.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.0",
    "astro": "7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "cheerio": "1.2.0",
    "csv-parse": "7.0.2",
    "csv-stringify": "6.8.3",
    "marked": "18.0.11",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.4",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "typescript": "6.0.3",
    "yaml": "2.9.0"
  }
}
