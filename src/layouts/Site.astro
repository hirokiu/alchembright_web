---
import '../styles/site.css';
interface Props { title: string; path: string; }
const {title,path} = Astro.props;
const preview = import.meta.env.PUBLIC_SITE_MODE !== 'production';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'home' ? 'Alchembright' : `${title} — Alchembright`}</title>
    <link rel="canonical" href={new URL(path, 'https://www.alchembright.com').href} />
    <link rel="alternate" type="application/rss+xml" title="Alchembright" href="/feed.xml" />
    {preview && <meta name="robots" content="noindex,nofollow" />}
  </head>
  <body>
    <a class="skip" href="#content">本文へ</a>
    <header>
      <a class="brand" href="/">Alchembright</a>
      <nav aria-label="メインメニュー">
        <a href="/">home</a><a href="/category/news/">news</a><a href="/category/works/">works</a><a href="/category/blog/">blog</a><a href="/about/">about</a>
      </nav>
    </header>
    <main id="content"><slot /></main>
    <footer><a href="/category/blog/">Blog</a><a href="/feed.xml">RSS</a><a href="/kirokun-support/">KIROKUN プライバシーポリシー</a><span>Alchembright</span></footer>
  </body>
</html>
