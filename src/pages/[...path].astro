---
import { render } from 'astro:content';
import Site from '../layouts/Site.astro';
import { routes, categories, tags, pathOf, archiveYears, type Route } from '../lib/routes';
export async function getStaticPaths() {
  return (await routes()).map(route => ({ params: { path: route.path === '/' ? undefined : route.path.slice(1,-1) }, props: { route } }));
}
interface Props { route: Route; }
const { route } = Astro.props;
const rendered = route.entry ? await render(route.entry) : null;
const Content = rendered?.Content;
const entry = route.entry;
const post = entry?.data.content_type === 'post';
const years = await archiveYears();
---
<Site title={route.title} path={route.path}>
  {entry && Content ? (
    <article class="article">
      {post && <div class="eyebrow"><a href="/category/blog/">Blog</a><time datetime={entry.data.published_at_local.slice(0,10)}>{entry.data.published_at_local.slice(0,10)}</time></div>}
      <h1>{route.title}</h1>
      <div class="prose" data-source-id={entry.data.source_id}><Content /></div>
      {post && <nav class="terms" aria-label="この記事の分類">{categories.filter(c=>entry.data.category_ids.includes(c.id)).map(c=><a href={pathOf(c.link)}>{c.name}</a>)}{tags.filter(t=>entry.data.tag_ids.includes(t.id)).map(t=><a href={pathOf(t.link)}>#{t.name}</a>)}</nav>}
    </article>
  ) : (
    <section class="archive">
      <div class="eyebrow">Alchembright / Archive</div>
      <h1>{route.title}</h1>
      {route.entries?.length ? <ol class="entries">{route.entries.map(e=><li><time datetime={e.data.published_at_local.slice(0,10)}>{e.data.published_at_local.slice(0,10)}</time><div><h2><a href={e.data.canonical_path}>{e.data.title}</a></h2>{e.data.excerpt && <p>{e.data.excerpt.slice(0,160)}</p>}</div></li>)}</ol> : <p>この分類にはまだ記事がありません。</p>}
      <nav class="pagination" aria-label="ページ送り">
        {route.page! > 1 && <a rel="prev" href={route.page===2?route.base:`${route.base}page/${route.page!-1}/`}>← 前のページ</a>}
        <span>{route.page} / {route.totalPages}</span>
        {route.page! < route.totalPages! && <a rel="next" href={`${route.base}page/${route.page!+1}/`}>次のページ →</a>}
      </nav>
      <aside><h2>年別に読む</h2><div class="years">{years.map(y=><a href={`/${y}/`}>{y}</a>)}</div><h2>カテゴリー</h2><div class="years">{categories.map(c=><a href={pathOf(c.link)}>{c.name}</a>)}</div></aside>
    </section>
  )}
</Site>
